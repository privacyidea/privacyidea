{
  "name": "privacyidea-webui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start-hmr": "ng serve --hmr --port 4200",
    "lint": "ng lint",
    "lint:css-vars": "node tools/check-css-vars.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "i18n:extract": "ng extract-i18n",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "format:write": "prettier --write \"src/**/*.{ts,html,scss,css,json}\""
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.23",
    "@angular/platform-browser-dynamic": "21.2.23",
    "@angular/router": "21.2.23",
    "crypto-js": "^4.2.0",
    "material-icons": "^1.13.14",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.3",
    "@angular-devkit/build-angular": "^21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@angular/localize": "21.2.23",
    "@eslint/js": "^10.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.0.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ng-extract-i18n-merge": "3.4.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
