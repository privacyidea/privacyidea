#: lib/eventhandler/base.py:186
msgid ""
"The challenge session matches the string or regular expression (like "
"'challenge_declined' or 'enrollment')"
msgstr ""
"ເຊສຊັ່ນການທ້າທາຍກົງກັບຂໍ້ຄວາມ ຫຼື ນິພົດປົກກະຕິ (ເຊັ່ນ "
"'challenge_declined' ຫຼື 'enrollment')"

#: lib/eventhandler/base.py:193
msgid "The challenge of a token during the authentication process is expired."
msgstr "ການທ້າທາຍຂອງໂທເຄັນໃນລະຫວ່າງຂະບວນການຢັ້ງຢືນຕົວຕົນໄດ້ໝົດອາຍຸແລ້ວ."

#: lib/eventhandler/base.py:201
msgid ""
"The rollout_state of the token has a certain value like 'clientwait' or "
"'enrolled'."
msgstr ""
"ສະຖານະການຕິດຕັ້ງ (rollout_state) ຂອງໂທເຄັນມີຄ່າສະເພາະເຊັ່ນ 'clientwait' "
"ຫຼື 'enrolled'."

#: lib/eventhandler/base.py:207
msgid "The realm of the user, for which this event should apply."
msgstr "ເລມ (realm) ຂອງຜູ້ໃຊ້, ທີ່ເຫດການນີ້ຄວນນຳໃຊ້."

#: lib/eventhandler/base.py:214
msgid "The resolver of the user, for which this event should apply."
msgstr "ຣີໂຊລເວີ (resolver) ຂອງຜູ້ໃຊ້, ທີ່ເຫດການນີ້ຄວນນຳໃຊ້."

#: lib/eventhandler/base.py:221
#, fuzzy, python-brace-format
msgid ""
"This condition can check any arbitrary user info field. You need to enter"
" something like '<fieldname> == <fieldvalue>', '<fieldname> > "
"<fieldvalue>' or '<fieldname> < <fieldvalue>'.You can use '{now}' for "
"time-based comparisons, e.g. 'last_login < {now} - 7d'"
msgstr ""
"ເງື່ອນໄຂນີ້ສາມາດກວດສອບຊ່ອງຂໍ້ມູນ tokeninfo ໃດກໍໄດ້ຕາມໃຈມັກ. "
"ທ່ານຈຳເປັນຕ້ອງໃສ່ຂໍ້ມູນເຊັ່ນ '<fieldname> == <fieldvalue>', '<fieldname> "
"> <fieldvalue>' ຫຼື '<fieldname> < <fieldvalue>'."

#: lib/eventhandler/base.py:232
msgid "The realm of the token, for which this event should apply."
msgstr "ເລມ (realm) ຂອງໂທເຄັນ, ທີ່ເຫດການນີ້ຄວນນຳໃຊ້."

#: lib/eventhandler/base.py:240
msgid "The resolver of the token, for which this event should apply."
msgstr "ຣີໂຊລເວີ (resolver) ຂອງໂທເຄັນ, ທີ່ເຫດການນີ້ຄວນນຳໃຊ້."

#: lib/eventhandler/base.py:248
msgid "The type of the token."
msgstr "ປະເພດຂອງໂທເຄັນ."

#: lib/eventhandler/base.py:255
msgid "The logged in user is of the following type."
msgstr "ຜູ້ໃຊ້ທີ່ເຂົ້າສູ່ລະບົບເປັນປະເພດດັ່ງຕໍ່ໄປນີ້."

#: lib/eventhandler/base.py:262
msgid "The result.value within the response is True or False."
msgstr "ຄ່າ result.value ພາຍໃນການຕອບກັບແມ່ນ True ຫຼື False."

#: lib/eventhandler/base.py:270
msgid "The result.status within the response is True or False."
msgstr "ສະຖານະ result.status ພາຍໃນການຕອບກັບແມ່ນ True ຫຼື False."

#: lib/eventhandler/base.py:278
msgid "The result.authentication within the response is the given value."
msgstr "ການຢັ້ງຢືນ result.authentication ພາຍໃນການຕອບກັບແມ່ນຄ່າທີ່ກຳນົດໃຫ້."

#: lib/eventhandler/base.py:286
msgid "Check if the max failcounter of the token is reached."
msgstr "ກວດສອບວ່າຕົວນັບຄວາມຜິດພາດສູງສຸດຂອງໂທເຄັນຖືກບັນລຸແລ້ວຫຼືບໍ່."

#: lib/eventhandler/base.py:294
msgid "The token has a user assigned."
msgstr "ໂທເຄັນມີຜູ້ໃຊ້ທີ່ຖືກມອບໝາຍ."

#: lib/eventhandler/base.py:301
msgid ""
"The token has a user assigned, but the user does not exist in the "
"userstore anymore."
msgstr ""
"ໂທເຄັນມີຜູ້ໃຊ້ທີ່ຖືກມອບໝາຍ, ແຕ່ຜູ້ໃຊ້ນັ້ນບໍ່ມີຢູ່ໃນບ່ອນເກັບຂໍ້ມູນຜູ້ໃຊ້ "
"(userstore) ອີກຕໍ່ໄປ."

#: lib/eventhandler/base.py:309
msgid "Check if the token is within its validity period."
msgstr "ກວດສອບວ່າໂທເຄັນຢູ່ໃນໄລຍະເວລາທີ່ມີຜົນບັງຄັບໃຊ້ຫຼືບໍ່."

#: lib/eventhandler/base.py:316
msgid "Action is triggered, if the serial matches this regular expression."
msgstr "ການກະທຳຈະຖືກກະຕຸ້ນ, ຖ້າຫາກເລກຊີຣຽນກົງກັບນິພົດປົກກະຕິນີ້."

#: lib/eventhandler/base.py:323
msgid "The token is in a container."
msgstr "ໂທເຄັນຢູ່ໃນຄອນເທນເນີ."

#: lib/eventhandler/base.py:330
msgid ""
"Action is triggered if the user has this number of tokens assigned. > and"
" < can be used, like <8."
msgstr ""
"ການກະທຳຈະຖືກກະຕຸ້ນຖ້າຜູ້ໃຊ້ມີຈຳນວນໂທເຄັນທີ່ຖືກມອບໝາຍເທົ່ານີ້. ສາມາດໃຊ້ > "
"ແລະ < ໄດ້, ເຊັ່ນ <8."

#: lib/eventhandler/base.py:337
msgid ""
"Action is triggered if the number of containers assigned to the user "
"matches the condition. The condition should start with a comparator such "
"as '==', '<', '>', followed by a number, e.g. '==0', '>3'."
msgstr ""
"ການກະທຳຈະຖືກກະຕຸ້ນຖ້າຈຳນວນຄອນເທນເນີທີ່ມອບໝາຍໃຫ້ຜູ້ໃຊ້ກົງກັບເງື່ອນໄຂ. "
"ເງື່ອນໄຂຄວນເລີ່ມຕົ້ນດ້ວຍຕົວປຽບທຽບເຊັ່ນ '==', '<', '>', ຕາມດ້ວຍຕົວເລກ, "
"ເຊັ່ນ '==0', '>3'."

#: lib/eventhandler/base.py:345
msgid ""
"Action is triggered, if the counter of the token equals this setting. Can"
" also be '>100' or '<99' for no exact match."
msgstr ""
"ການກະທຳຈະຖືກກະຕຸ້ນ, ຖ້າຕົວນັບຂອງໂທເຄັນເທົ່າກັບການຕັ້ງຄ່ານີ້. ສາມາດເປັນ "
"'>100' ຫຼື '<99' ສຳລັບການບໍ່ກົງກັນແບບແນ່ນອນ."

#: lib/eventhandler/base.py:353
msgid ""
"Action is triggered, if the last authentication of the token is older "
"than 7h, 10d or 1y."
msgstr ""
"ການກະທຳຈະຖືກກະຕຸ້ນ, ຖ້າການຢັ້ງຢືນຕົວຕົນຄັ້ງຫຼ້າສຸດຂອງໂທເຄັນເກົ່າກວ່າ 7 "
"ຊົ່ວໂມງ, 10 ມື້ ຫຼື 1 ປີ."

#: lib/eventhandler/base.py:360
msgid ""
"This can be '>100', '<99', or '=100', to trigger the action, if the "
"tokeninfo field 'count_auth' is bigger than 100, less than 99 or exactly "
"100."
msgstr ""
"ນີ້ສາມາດເປັນ '>100', '<99', ຫຼື '=100', ເພື່ອກະຕຸ້ນການກະທຳ, ຖ້າຊ່ອງຂໍ້ມູນ"
" tokeninfo 'count_auth' ໃຫຍ່ກວ່າ 100, ນ້ອຍກວ່າ 99 ຫຼື ເທົ່າກັບ 100 ພໍດີ."

#: lib/eventhandler/base.py:368
msgid ""
"This can be '>100', '<99', or '=100', to trigger the action, if the "
"tokeninfo field 'count_auth_success' is bigger than 100, less than 99 or "
"exactly 100."
msgstr ""
"ນີ້ສາມາດເປັນ '>100', '<99', ຫຼື '=100', ເພື່ອກະຕຸ້ນການກະທຳ, ຖ້າຊ່ອງຂໍ້ມູນ"
" tokeninfo 'count_auth_success' ໃຫຍ່ກວ່າ 100, ນ້ອຍກວ່າ 99 ຫຼື ເທົ່າກັບ "
"100 ພໍດີ."

#: lib/eventhandler/base.py:377
msgid ""
"This can be '>100', '<99', or '=100', to trigger the action, if the "
"difference between the tokeninfo field 'count_auth' and "
"'count_auth_success is bigger than 100, less than 99 or exactly 100."
msgstr ""
"ນີ້ສາມາດເປັນ '>100', '<99', ຫຼື '=100', ເພື່ອກະຕຸ້ນການກະທຳ, "
"ຖ້າຄວາມແຕກຕ່າງລະຫວ່າງຊ່ອງຂໍ້ມູນ tokeninfo 'count_auth' ແລະ "
"'count_auth_success' ໃຫຍ່ກວ່າ 100, ນ້ອຍກວ່າ 99 ຫຼື ເທົ່າກັບ 100 ພໍດີ."

#: lib/eventhandler/base.py:386
msgid ""
"This can be '>9', '<9', or '=10', to trigger the action, if the "
"failcounter of a token matches this value. Note that the failcounter "
"stops increasing, if the max_failcount is reached."
msgstr ""
"ນີ້ສາມາດເປັນ '>9', '<9', ຫຼື '=10', ເພື່ອກະຕຸ້ນການກະທຳ, "
"ຖ້າຕົວນັບຄວາມຜິດພາດຂອງໂທເຄັນກົງກັບຄ່ານີ້. "
"ໝາຍເຫດວ່າຕົວນັບຄວາມຜິດພາດຈະຢຸດເພີ່ມ, ຖ້າຫາກບັນລຸ max_failcount."

#: lib/eventhandler/base.py:395
msgid ""
"This condition can check any arbitrary tokeninfo field. You need to enter"
" something like '<fieldname> == <fieldvalue>', '<fieldname> > "
"<fieldvalue>' or '<fieldname> < <fieldvalue>'."
msgstr ""
"ເງື່ອນໄຂນີ້ສາມາດກວດສອບຊ່ອງຂໍ້ມູນ tokeninfo ໃດກໍໄດ້ຕາມໃຈມັກ. "
"ທ່ານຈຳເປັນຕ້ອງໃສ່ຂໍ້ມູນເຊັ່ນ '<fieldname> == <fieldvalue>', '<fieldname> "
"> <fieldvalue>' ຫຼື '<fieldname> < <fieldvalue>'."

#: lib/eventhandler/base.py:404
msgid ""
"This condition can check the value of an arbitrary event counter and "
"compare it like 'myCounter == 1000', 'myCounter > 1000' or 'myCounter < "
"1000'."
msgstr ""
"ເງື່ອນໄຂນີ້ສາມາດກວດສອບຄ່າຂອງຕົວນັບເຫດການໃດກໍໄດ້ ແລະ ປຽບທຽບມັນເຊັ່ນ "
"'myCounter == 1000', 'myCounter > 1000' ຫຼື 'myCounter < 1000'."

#: lib/eventhandler/base.py:412
msgid ""
"Here you can enter a regular expression. The condition only applies if "
"the regular expression matches the detail->error->message in the "
"response."
msgstr ""
"ທີ່ນີ້ທ່ານສາມາດໃສ່ນິພົດປົກກະຕິ. "
"ເງື່ອນໄຂຈະນຳໃຊ້ກໍຕໍ່ເມື່ອນິພົດປົກກະຕິກົງກັບ detail->error->message "
"ໃນການຕອບກັບ."

#: lib/eventhandler/base.py:420
msgid ""
"Here you can enter a regular expression. The condition only applies if "
"the regular expression matches the detail->message in the response."
msgstr ""
"ທີ່ນີ້ທ່ານສາມາດໃສ່ນິພົດປົກກະຕິ. "
"ເງື່ອນໄຂຈະນຳໃຊ້ກໍຕໍ່ເມື່ອນິພົດປົກກະຕິກົງກັບ detail->message ໃນການຕອບກັບ."

#: lib/eventhandler/base.py:428
msgid "Trigger the action, if the client IP matches."
msgstr "ກະຕຸ້ນການກະທຳ, ຖ້າໄອພີຂອງລູກຄ້າກົງກັນ."

#: lib/eventhandler/base.py:434
msgid ""
"The container is in the specified states, but can additionally be in "
"other states."
msgstr "ຄອນເທນເນີຢູ່ໃນສະຖານະທີ່ລະບຸ, ແຕ່ຍັງສາມາດຢູ່ໃນສະຖານະອື່ນໆເພີ່ມເຕີມໄດ້."

#: lib/eventhandler/base.py:441
msgid "The container is only in the specified states."
msgstr "ຄອນເທນເນີຢູ່ໃນສະຖານະທີ່ລະບຸເທົ່ານັ້ນ."

#: lib/eventhandler/base.py:448
msgid "The container has a user assigned."
msgstr "ຄອນເທນເນີມີຜູ້ໃຊ້ທີ່ຖືກມອບໝາຍ."

#: lib/eventhandler/base.py:455
msgid "The container has at least one token assigned."
msgstr "ຄອນເທນເນີມີໂທເຄັນທີ່ຖືກມອບໝາຍຢ່າງໜ້ອຍໜຶ່ງອັນ."

#: lib/eventhandler/base.py:462
msgid "The container is of a certain type."
msgstr "ຄອນເທນເນີເປັນປະເພດໃດໜຶ່ງ."

#: lib/eventhandler/base.py:469
msgid ""
"The container is in this realm or in no realm at all. If multiple realms "
"are selected, the condition is fulfilled if the container is in at least "
"one realm of the list. The condition is not checked if the container has "
"no realm, hence the action would be triggered."
msgstr ""
"ຄອນເທນເນີຢູ່ໃນເລມນີ້ ຫຼື ບໍ່ມີເລມເລີຍ. ຖ້າເລືອກຫຼາຍເລມ, "
"ເງື່ອນໄຂຈະຖືກຕື່ມເຕັມຖ້າຄອນເທນເນີຢູ່ໃນເລມຢ່າງໜ້ອຍໜຶ່ງອັນຂອງລາຍການ. "
"ເງື່ອນໄຂຈະບໍ່ຖືກກວດສອບຖ້າຄອນເທນເນີບໍ່ມີເລມ, ສະນັ້ນການກະທຳຈະຖືກກະຕຸ້ນ."

#: lib/eventhandler/base.py:479
msgid ""
"An owner of the container is in this resolver. If multiple resolvers are "
"selected, the condition is fulfilled if at least one owner is in one "
"resolver. The condition is not checked if the container has no owner, "
"hence the action would be triggered."
msgstr ""
"ເຈົ້າຂອງຄອນເທນເນີຢູ່ໃນຣີໂຊລເວີນີ້. ຖ້າເລືອກຫຼາຍຣີໂຊລເວີ, "
"ເງື່ອນໄຂຈະຖືກຕື່ມເຕັມຖ້າມີເຈົ້າຂອງຢ່າງໜ້ອຍໜຶ່ງຄົນຢູ່ໃນໜຶ່ງຣີໂຊລເວີ. "
"ເງື່ອນໄຂຈະບໍ່ຖືກກວດສອບຖ້າຄອນເທນເນີບໍ່ມີເຈົ້າຂອງ, "
"ສະນັ້ນການກະທຳຈະຖືກກະຕຸ້ນ."

#: lib/eventhandler/base.py:488
msgid ""
"This condition can check any arbitrary container info field. You need to "
"enter something like 'fieldname == fieldvalue', 'fieldname > fieldvalue' "
"or 'fieldname < fieldvalue'."
msgstr ""
"ເງື່ອນໄຂນີ້ສາມາດກວດສອບຊ່ອງຂໍ້ມູນຄອນເທນເນີໃດກໍໄດ້ຕາມໃຈມັກ. "
"ທ່ານຈຳເປັນຕ້ອງໃສ່ຂໍ້ມູນເຊັ່ນ 'fieldname == fieldvalue', 'fieldname > "
"fieldvalue' ຫຼື 'fieldname < fieldvalue'."

#: lib/eventhandler/base.py:497
msgid ""
"Action is triggered, if the last authentication of the container is older"
" than the specified time. The time value has to be an integer followed by"
" a time unit. Supported units are 'y' (years), 'd' (days), 'h' (hours), "
"'m' (minutes), 's' (seconds). Only one unit is allowed. Examples: '8h', "
"'7d', '1y'"
msgstr ""
"ການກະທຳຈະຖືກກະຕຸ້ນ, "
"ຖ້າການຢັ້ງຢືນຕົວຕົນຄັ້ງຫຼ້າສຸດຂອງຄອນເທນເນີເກົ່າກວ່າເວລາທີ່ລະບຸ. "
"ຄ່າເວລາຕ້ອງເປັນຈຳນວນເຕັມຕາມດ້ວຍໜ່ວຍເວລາ. ໜ່ວຍທີ່ຮອງຮັບແມ່ນ 'y' (ປີ), 'd' "
"(ມື້), 'h' (ຊົ່ວໂມງ), 'm' (ນາທີ), 's' (ວິນາທີ). "
"ອະນຸຍາດໃຫ້ໃຊ້ໄດ້ພຽງໜຶ່ງໜ່ວຍເທົ່ານັ້ນ. ຕົວຢ່າງ: '8h', '7d', '1y'"

#: lib/eventhandler/base.py:508
msgid ""
"Action is triggered, if the last synchronization of the container is "
"older than the specified time. The time value has to be an integer "
"followed by a time unit. Supported units are 'y' (years), 'd' (days), 'h'"
" (hours), 'm' (minutes), 's' (seconds). Only one unit is allowed. "
"Examples: '8h', '7d', '1y'"
msgstr ""
"ການກະທຳຈະຖືກກະຕຸ້ນ, "
"ຖ້າການຊິງໂຄຣໄນຄັ້ງຫຼ້າສຸດຂອງຄອນເທນເນີເກົ່າກວ່າເວລາທີ່ລະບຸ. "
"ຄ່າເວລາຕ້ອງເປັນຈຳນວນເຕັມຕາມດ້ວຍໜ່ວຍເວລາ. ໜ່ວຍທີ່ຮອງຮັບແມ່ນ 'y' (ປີ), 'd' "
"(ມື້), 'h' (ຊົ່ວໂມງ), 'm' (ນາທີ), 's' (ວິນາທີ). "
"ອະນຸຍາດໃຫ້ໃຊ້ໄດ້ພຽງໜຶ່ງໜ່ວຍເທົ່ານັ້ນ. ຕົວຢ່າງ: '8h', '7d', '1y'"

