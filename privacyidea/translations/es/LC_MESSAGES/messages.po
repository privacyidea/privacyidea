#: lib/conditional_access/policy_template.py:69
msgid ""
"Lock a single user after repeated wrong passwords or PINs (password brute-"
"force)."
msgstr ""

#: lib/conditional_access/policy_template.py:92
msgid ""
"Progressively lock a user whose password is correct but whose second factor "
"keeps failing (MFA brute-force)."
msgstr ""

#: lib/conditional_access/policy_template.py:167
msgid ""
"Rate-limit a single user's authentication: once too many attempts happen in "
"a short window, further attempts are briefly denied. Counts every attempt - "
"successful, failed or abandoned - and never locks the account (the denial "
"lifts as the window drains)."
msgstr ""

#: lib/conditional_access/policy_template.py:192
msgid ""
"Rate-limit a single user's failed authentication attempts: after too many "
"failures in a short window, further attempts are briefly denied. Successful "
"logins are not counted, so a busy legitimate user is unaffected - only a "
"guessing burst is throttled."
msgstr ""

#: lib/conditional_access/policy_template.py:214
msgid ""
"Block a source IP that fails first-factor authentication (wrong password or "
"PIN) against many different users in a short time (password spraying / "
"credential stuffing)."
msgstr ""

#: lib/conditional_access/policy_template.py:238
msgid ""
"Block a source IP that probes many different non-existent usernames in a "
"short time (user enumeration)."
msgstr ""

#: lib/conditional_access/policy_template.py:261
msgid ""
"Rate-limit a source IP that fails authentication against many different "
"accounts in a short window (credential stuffing, spraying or user "
"enumeration): further requests from that IP are briefly denied."
msgstr ""

#: lib/conditional_access/policy_template.py:285
msgid ""
"Rate-limit a source IP by how many different accounts it authenticates as in "
"a short window, regardless of success."
msgstr ""

