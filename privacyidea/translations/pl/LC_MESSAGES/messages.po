#: api/auth.py:290
msgid "Authentication with passkey disabled."
msgstr "Uwierzytelnianie kluczem dostępu jest wyłączone."

# | msgid "Authentication failure. Missing Username"
#: api/auth.py:295
msgid "Authentication failure. The passkey is not registered."
msgstr ""
"Uwierzytelnianie nie powiodło się. Klucz dostępu nie jest zarejestrowany."

# | msgid "Authentication failure. Your token has expired: {0!s}"
#: api/auth.py:307
msgid "Authentication failure. Token has no user."
msgstr ""
"Uwierzytelnianie nie powiodło się. Do tokena nie przypisano użytkownika."

#: api/auth.py:311
#, python-brace-format
msgid "Authentication failure. The token type {token_type} is disabled."
msgstr ""
"Uwierzytelnianie nie powiodło się. Typ tokena {token_type} jest wyłączony."

#: api/auth.py:317
#, python-brace-format
msgid ""
"Authentication failure. Last authentication policy check failed for token "
"{serial}"
msgstr ""
"Uwierzytelnianie nie powiodło się. Token {serial} nie spełnia polityki "
"ostatniego uwierzytelnienia."

# | msgid "Authentication failure. Missing Username"
#: api/auth.py:330
msgid "Authentication failure using passkey."
msgstr "Uwierzytelnianie kluczem dostępu nie powiodło się."

# | msgid "Authentication failure. Unknown realm: {0!s}."
#: api/auth.py:335
msgid "Authentication failure. Unknown realm:"
msgstr "Uwierzytelnianie nie powiodło się. Nieznana domena:"

#: api/auth.py:339
msgid "Authentication failure. Missing Username"
msgstr "Uwierzytelnianie nie powiodło się: brak nazwy użytkownika."

#: api/auth.py:481
msgid "Authentication failure. Wrong credentials"
msgstr "Uwierzytelnianie nie powiodło się: błędne dane logowania."

# | msgid "Authentication failure. Missing Username"
#: api/before_after.py:518 api/lib/postpolicy.py:977 api/validate.py:664
msgid "Authentication failed."
msgstr "Uwierzytelnianie nie powiodło się."

#: api/container.py:275
msgid "Missing parameter 'realm', 'resolver', and/or 'user_id'"
msgstr "Brak parametru 'realm', 'resolver' lub 'user_id'"

#: api/container.py:1412
msgid "'template_options' must be a dictionary!"
msgstr "'template_options' musi być słownikiem!"

#: api/periodictask.py:204
msgid "nodes: expected at least one node"
msgstr "nodes: wymagany jest co najmniej jeden węzeł"

#: api/periodictask.py:207
#, python-brace-format
msgid "Unknown task module: {!r}"
msgstr "Nieznany moduł zadania: {!r}"

#: api/periodictask.py:215
#, python-brace-format
msgid "options: expected dictionary, got {!r}"
msgstr "options: oczekiwano dict, otrzymano {!r}"

#: api/policy.py:480 api/token.py:1294
msgid "Unable to convert file contents. Binary data is not supported"
msgstr ""
"Nie można przekonwertować zawartości pliku. Dane binarne nie są obsługiwane"

#: api/policy.py:485
msgid "Error loading policy. File empty!"
msgstr "Nie udało się wczytać polityki. Plik jest pusty!"

#: api/realm.py:542
msgid "The given node does not exist!"
msgstr "Podany węzeł nie istnieje!"

#: api/realm.py:548 api/realm.py:558
msgid "Could not verify data in request!"
msgstr "Nie udało się zweryfikować danych w żądaniu!"

#: api/register.py:146
msgid "No SMTP server configuration specified!"
msgstr "Nie określono konfiguracji serwera SMTP!"

#: api/register.py:160
msgid "No resolver specified to register in!"
msgstr "Nie określono źródła użytkowników do rejestracji!"

#: api/register.py:167
msgid "The username is already registered!"
msgstr "Ta nazwa użytkownika jest już zarejestrowana!"

#: api/register.py:198
msgid "Failed to send email!"
msgstr "Nie udało się wysłać wiadomości e-mail!"

#: api/system.py:354
#, python-brace-format
msgid "Usage: {0!s}"
msgstr "Użycie: {0!s}"

#: api/token.py:1273
msgid ""
"The Pre Shared Key must be 128 Bit hex encoded. It must be 32 characters "
"long!"
msgstr ""
"Klucz współdzielony musi być 128-bitową wartością szesnastkową o długości 32 "
"znaków!"

#: api/token.py:1298
msgid "Error loading token file. File empty!"
msgstr "Nie udało się wczytać pliku tokenów. Plik jest pusty!"

#: api/token.py:1304
#, python-brace-format
msgid ""
"Unknown file type: '{file_type}'. Supported file types are: {known_types}"
msgstr ""
"Nieznany typ pliku: '{file_type}'. Obsługiwane typy plików: {known_types}"

#: api/token.py:1425
#, python-brace-format
msgid "The user {0!r} does not own the token {1!s}"
msgstr "Użytkownik {0!r} nie jest właścicielem tokena {1!s}"

#: api/user.py:205
#, python-brace-format
msgid ""
"Invalid attribute name! The name shall not start with {prefix}. This is an "
"internally used prefix."
msgstr ""
"Nieprawidłowa nazwa atrybutu! Nazwa nie może zaczynać się od {prefix}. Ten "
"prefiks jest używany wewnętrznie."

#: api/validate.py:260
msgid "The token does not exist"
msgstr "Token nie istnieje"

#: api/validate.py:267
msgid "The token is not valid."
msgstr "Token jest nieważny."

#: api/validate.py:280
msgid "Machine can not be identified by user agent!"
msgstr "Nie można zidentyfikować maszyny na podstawie nagłówka User-Agent!"

#: api/validate.py:296
msgid "Token is not an offline token or refill token is incorrect"
msgstr ""
"Token nie jest tokenem offline albo token uzupełniający jest nieprawidłowy"

#: api/validate.py:553
msgid "Cancelled enrollment via multichallenge"
msgstr "Anulowano rejestrację w trybie wielu wyzwań"

#: api/validate.py:554
msgid "Cancelled enrollment via multichallenge for transaction_id "
msgstr "Anulowano rejestrację w trybie wielu wyzwań dla transaction_id "

#: api/validate.py:556
msgid "Failed to cancel enrollment via multichallenge"
msgstr "Nie udało się anulować rejestracji w trybie wielu wyzwań"

#: api/validate.py:557
msgid "Failed to cancel enrollment via multichallenge for transaction_id "
msgstr ""
"Nie udało się anulować rejestracji w trybie wielu wyzwań dla transaction_id "

#: api/validate.py:594 api/validate.py:1091
msgid "The authentication method is not available."
msgstr "Ta metoda uwierzytelniania jest niedostępna."

#: api/validate.py:635
#, python-brace-format
msgid "Last authentication policy check failed for token {serial}"
msgstr "Token {serial} nie spełnia polityki ostatniego uwierzytelnienia"

#: api/validate.py:659 lib/token.py:2678
msgid "Found matching challenge"
msgstr "Znaleziono pasujące wyzwanie"

#: api/validate.py:680 api/validate.py:682
msgid "Given serial does not belong to given user!"
msgstr "Podany numer seryjny nie należy do wskazanego użytkownika!"

#: api/validate.py:1108
#, python-brace-format
msgid ""
"Unsupported token type '{token_type}' for authentication initialization!"
msgstr "Typ tokena '{token_type}' nie obsługuje inicjowania uwierzytelniania!"

#: api/lib/postpolicy.py:98
#, python-brace-format
msgid ""
"\n"
"<--- Please describe your Problem in detail --->\n"
"\n"
"<--- Please provide as much additional information as possible --->\n"
"\n"
"privacyIDEA Version: {version}\n"
"Subscriber: {subscriber_name}\n"
"Subscriptions: {subscriptions}\n"
msgstr ""
"\n"
"<--- Szczegółowo opisz problem --->\n"
"\n"
"<--- Podaj jak najwięcej dodatkowych informacji --->\n"
"\n"
"Wersja privacyIDEA: {version}\n"
"Subskrybent: {subscriber_name}\n"
"Subskrypcje: {subscriptions}\n"

#: api/lib/postpolicy.py:910
msgid "Please scan the QR code to register the container."
msgstr "Zeskanuj kod QR, aby zarejestrować kontener."

#: api/lib/prepolicy.py:2637 api/lib/prepolicy.py:2673
#, python-brace-format
msgid "Description required for {type_value} token."
msgstr "Token typu {type_value} wymaga opisu."

#: api/lib/prepolicy.py:2906
msgid ""
"Authentication failure. The account has exceeded the authentication time "
"limit!"
msgstr ""
"Uwierzytelnianie nie powiodło się. Dla konta przekroczono limit "
"uwierzytelnień w określonym czasie!"

#: api/lib/utils.py:402
msgid "Authentication failure. Missing Authorization header."
msgstr "Uwierzytelnianie nie powiodło się: brak nagłówka Authorization."

# | msgid "Authentication failure. Error during decoding your token: {0!s}"
#: api/lib/utils.py:407 api/lib/utils.py:438
msgid "Authentication failure. Error decoding the Authorization token:"
msgstr ""
"Uwierzytelnianie nie powiodło się. Błąd dekodowania tokena z nagłówka "
"Authorization:"

# | msgid "Authentication failure. Your token has expired: {0!s}"
#: api/lib/utils.py:431 api/lib/utils.py:441
msgid "Authentication failure. Your token has expired:"
msgstr "Uwierzytelnianie nie powiodło się. Token wygasł:"

#: api/lib/utils.py:444
#, python-brace-format
msgid ""
"Authentication failure. The username {wrong_username} is not allowed to "
"impersonate via JWT."
msgstr ""
"Uwierzytelnianie nie powiodło się. Nazwy użytkownika {wrong_username} nie "
"można użyć do podszywania się przez JWT."

# | msgid ""
# | "Authentication failure. You do not have the necessary role ({0!s}) to "
# | "access this resource!"
#: api/lib/utils.py:449
#, python-brace-format
msgid ""
"Authentication failure. You do not have the necessary role ({required_role}) "
"to access this resource!"
msgstr ""
"Uwierzytelnianie nie powiodło się. Dostęp do tego zasobu wymaga roli ("
"{required_role})!"

# | msgid "'{0!s}' is an invalid policy name."
#: api/lib/utils.py:466
msgid "Invalid policy name:"
msgstr "Nieprawidłowa nazwa polityki:"

#: api/lib/utils.py:469
msgid "The name of the policy may only contain the characters a-zA-Z0-9_. -"
msgstr "Nazwa polityki może zawierać tylko znaki a-zA-Z0-9_. -"

#: lib/challengeresponsedecorators.py:150
msgid "Please enter the new PIN again"
msgstr "Wprowadź ponownie nowy PIN"

#: lib/challengeresponsedecorators.py:164
msgid "Please enter a new PIN"
msgstr "Wprowadź nowy PIN"

#: lib/challengeresponsedecorators.py:202
msgid "To resync your token, please enter the next OTP value"
msgstr "Aby ponownie zsynchronizować token, wprowadź kolejny kod OTP"

#: lib/containerclass.py:919
msgid ""
"General purpose container that can hold any type and any number of token."
msgstr ""
"Kontener ogólnego przeznaczenia na dowolną liczbę tokenów dowolnego typu."

#: lib/decorators.py:44 lib/token.py:2526
msgid "This action is not possible, since the token is locked"
msgstr "Ta akcja jest niedostępna, ponieważ token jest zablokowany"

#: lib/decorators.py:87
msgid "You either need to provide user or serial"
msgstr "Podaj użytkownika albo numer seryjny"

#: lib/decorators.py:116
msgid "You need to specify a serial, user or credential_id."
msgstr "Podaj numer seryjny, użytkownika lub credential_id."

#: lib/decorators.py:118
msgid "Invalid serial number."
msgstr "Nieprawidłowy numer seryjny."

#: lib/decorators.py:120
msgid "Invalid user."
msgstr "Nieprawidłowy użytkownik."

#: lib/policy.py:218
msgid ""
"Note: If you use a comma in the message, you need to escape it with a "
"backslash."
msgstr "Uwaga: przecinek w komunikacie należy poprzedzić ukośnikiem odwrotnym."

#: lib/policy.py:1227
msgid "Policy does not exist:"
msgstr "Polityka nie istnieje:"

#: lib/policy.py:1230
msgid "Policy already exists:"
msgstr "Polityka już istnieje:"

#: lib/policy.py:1396
msgid "Invalid client definition!"
msgstr "Nieprawidłowa definicja klienta!"

#: lib/policy.py:1650
msgid "Define in which resolver the user should be registered."
msgstr "Określ źródło użytkowników, w którym ma nastąpić rejestracja."

#: lib/policy.py:1654
msgid "Define in which realm the user should be registered."
msgstr "Określ domenę, w której ma nastąpić rejestracja."

#: lib/policy.py:1658
msgid ""
"The SMTP server configuration, that should be used to send the registration "
"email."
msgstr ""
"Konfiguracja serwera SMTP używana do wysyłania wiadomości rejestracyjnej."

#: lib/policy.py:1662
msgid ""
"Only users with this email address are allowed to register. This is a "
"regular expression."
msgstr ""
"Rejestrować mogą się tylko użytkownicy z pasującym adresem e-mail. Wartość "
"jest wyrażeniem regularnym."

#: lib/policy.py:1667
#, python-brace-format
msgid ""
"The body of the registration email. Use '{regkey}' as tag for the "
"registration key."
msgstr ""
"Treść wiadomości rejestracyjnej. Użyj znacznika '{regkey}' w miejscu klucza "
"rejestracyjnego."

#: lib/policy.py:1671
msgid "Enable to return an unspecific error message for failed registrations."
msgstr "Zwracaj ogólny komunikat błędu po nieudanej rejestracji."

#: lib/policy.py:1677
msgid "Admin is allowed to enable tokens."
msgstr "Administrator może włączać tokeny."

#: lib/policy.py:1681
msgid "Admin is allowed to disable tokens."
msgstr "Administrator może wyłączać tokeny."

#: lib/policy.py:1686
msgid "Admin is allowed to set token properties."
msgstr "Administrator może ustawiać właściwości tokenów."

#: lib/policy.py:1690
msgid "The admin is allowed to set the token description."
msgstr "Administrator może ustawiać opis tokena."

#: lib/policy.py:1695
msgid "Admin is allowed to set the OTP PIN of tokens."
msgstr "Administrator może ustawiać PIN tokenów."

#: lib/policy.py:1700
msgid "Admin is allowed to set a random OTP PIN of tokens."
msgstr "Administrator może ustawiać losowy PIN tokenów."

#: lib/policy.py:1704
msgid "Admin is allowed to manually set and delete token info."
msgstr "Administrator może ręcznie ustawiać i usuwać informacje o tokenach."

#: lib/policy.py:1708
msgid "Admin is allowed to set the OTP PIN during enrollment."
msgstr "Administrator może ustawiać PIN tokena podczas rejestracji."

#: lib/policy.py:1713
msgid "Admin is allowed to resync tokens."
msgstr "Administrator może ponownie synchronizować tokeny."

#: lib/policy.py:1718
msgid "Admin is allowed to reset the Failcounter of a token."
msgstr "Administrator może zerować licznik błędów tokena."

#: lib/policy.py:1723
msgid "Admin is allowed to revoke a token"
msgstr "Administrator może unieważniać tokeny"

#: lib/policy.py:1728
msgid "Admin is allowed to assign a token to a user."
msgstr "Administrator może przypisywać tokeny użytkownikom."

#: lib/policy.py:1734
msgid ""
"Admin is allowed to remove the token from a user, i.e. unassign a token."
msgstr "Administrator może usuwać przypisanie tokena do użytkownika."

#: lib/policy.py:1740
msgid "Admin is allowed to import token files."
msgstr "Administrator może importować pliki tokenów."

#: lib/policy.py:1745
msgid "Admin is allowed to remove tokens from the database."
msgstr "Administrator może usuwać tokeny z bazy danych."

#: lib/policy.py:1751
msgid "Admin is allowed to view the list of the users."
msgstr "Administrator może wyświetlać listę użytkowników."

#: lib/policy.py:1756
msgid "The Admin is allowed to list the machines."
msgstr "Administrator może wyświetlać listę maszyn."

#: lib/policy.py:1761
msgid "The Admin is allowed to attach and detach tokens to machines."
msgstr "Administrator może wiązać tokeny z maszynami i je odłączać."

#: lib/policy.py:1768
msgid ""
"The Admin is allowed to fetch authentication items of tokens assigned to "
"machines."
msgstr ""
"Administrator może pobierać dane uwierzytelniające tokenów przypisanych do "
"maszyn."

#: lib/policy.py:1773
msgid "Admin is allowed to manage the realms of a token."
msgstr "Administrator może zarządzać domenami tokena."

#: lib/policy.py:1778
msgid "Admin is allowed to list tokens."
msgstr "Administrator może wyświetlać listę tokenów."

#: lib/policy.py:1782
msgid "Admin is allowed to retrieve a serial for a given OTP value."
msgstr "Administrator może pobierać numer seryjny dla podanego kodu OTP."

#: lib/policy.py:1787
msgid "Admin is allowed to retrieve random keys from privacyIDEA."
msgstr "Administrator może pobierać losowe klucze z privacyIDEA."

#: lib/policy.py:1792
msgid "Admin is allowed to copy the PIN of one token to another token."
msgstr "Administrator może kopiować PIN między tokenami."

#: lib/policy.py:1797
msgid ""
"Admin is allowed to copy the assigned user to another token, i.e. assign a "
"user to another token."
msgstr "Administrator może kopiować przypisanie użytkownika do innego tokena."

#: lib/policy.py:1802
msgid "Admin is allowed to trigger the lost token workflow."
msgstr "Administrator może uruchamiać procedurę utraconego tokena."

#: lib/policy.py:1808
msgid "Admin is allowed to write and modify the system configuration."
msgstr "Administrator może modyfikować konfigurację systemu."

#: lib/policy.py:1813
msgid "Admin is allowed to delete keys in the system configuration."
msgstr "Administrator może usuwać klucze z konfiguracji systemu."

#: lib/policy.py:1819
msgid "Admin is allowed to read basic system configuration."
msgstr "Administrator może odczytywać podstawową konfigurację systemu."

#: lib/policy.py:1824
msgid ""
"Admin is allowed to export a documentation of the complete configuration "
"including resolvers and realm."
msgstr ""
"Administrator może eksportować dokumentację pełnej konfiguracji, w tym "
"źródeł użytkowników i domen."

#: lib/policy.py:1832
msgid "Admin is allowed to write and modify the policies."
msgstr "Administrator może tworzyć i modyfikować polityki."

#: lib/policy.py:1837
msgid "Admin is allowed to delete policies."
msgstr "Administrator może usuwać polityki."

#: lib/policy.py:1842
msgid "Admin is allowed to read policies."
msgstr "Administrator może odczytywać polityki."

#: lib/policy.py:1846
msgid ""
"Admin is allowed to write and modify the resolver and realm configuration."
msgstr ""
"Administrator może tworzyć i modyfikować konfigurację źródeł użytkowników i "
"domen."

#: lib/policy.py:1853
msgid "Admin is allowed to delete resolvers and realms."
msgstr "Administrator może usuwać źródła użytkowników i domeny."

#: lib/policy.py:1858
msgid "Admin is allowed to read resolvers."
msgstr "Administrator może odczytywać źródła użytkowników."

#: lib/policy.py:1862
msgid ""
"Admin is allowed to create new CA Connector definitions and modify existing "
"ones."
msgstr "Administrator może tworzyć i modyfikować definicje łączników CA."

#: lib/policy.py:1868
msgid "Admin is allowed to delete CA Connector definitions."
msgstr "Administrator może usuwać definicje łączników CA."

#: lib/policy.py:1873
msgid "Admin is allowed to read CA Connector definitions."
msgstr "Administrator może odczytywać definicje łączników CA."

#: lib/policy.py:1878
msgid "Admin is allowed to write and modify the machine resolvers."
msgstr "Administrator może tworzyć i modyfikować źródła maszyn."

#: lib/policy.py:1884
msgid "Admin is allowed to delete machine resolvers."
msgstr "Administrator może usuwać źródła maszyn."

#: lib/policy.py:1890
msgid "Admin is allowed to read machine resolvers."
msgstr "Administrator może odczytywać źródła maszyn."

#: lib/policy.py:1897 lib/policy.py:2242
msgid "Set the maximum allowed length of the OTP PIN."
msgstr "Ustaw maksymalną dozwoloną długość PIN-u tokena."

#: lib/policy.py:1902 lib/policy.py:2246
msgid "Set the minimum required length of the OTP PIN."
msgstr "Ustaw minimalną wymaganą długość PIN-u tokena."

#: lib/policy.py:1906 lib/policy.py:2250
msgid ""
"Specify the required contents of the OTP PIN. (c)haracters, (n)umeric, "
"(s)pecial. Use modifiers +/- or a list of allowed characters [1234567890]"
msgstr ""
"Określ wymagane elementy PIN-u tokena: (c) znaki, (n) cyfry, (s) znaki "
"specjalne. Użyj modyfikatorów +/- lub listy dozwolonych znaków [1234567890]"

#: lib/policy.py:1915
msgid "The length of a random PIN set by the administrator."
msgstr "Długość losowego PIN-u ustawianego przez administratora."

#: lib/policy.py:1918
msgid "Admin is allowed to view the Audit log."
msgstr "Administrator może wyświetlać dziennik audytu."

#: lib/policy.py:1922
msgid "The admin will only see audit entries of the last 10d, 3m or 2y."
msgstr "Administrator zobaczy tylko wpisy audytu z ostatnich 10d, 3m lub 2y."

#: lib/policy.py:1927
msgid "The admin will not see the specified columns in the audit."
msgstr "Administrator nie zobaczy wskazanych kolumn audytu."

#: lib/policy.py:1932
msgid "The admin is allowed to download the complete auditlog."
msgstr "Administrator może pobierać pełny dziennik audytu."

#: lib/policy.py:1937
msgid "Admin is allowed to add users in a userstore/UserIdResolver."
msgstr ""
"Administrator może dodawać użytkowników w źródle użytkowników "
"(UserIdResolver)."

#: lib/policy.py:1942
msgid "Admin is allowed to update the users data in a userstore."
msgstr "Administrator może aktualizować dane w źródle użytkowników."

#: lib/policy.py:1947
msgid "Admin is allowed to delete a user object in a userstore."
msgstr "Administrator może usuwać użytkowników ze źródła użytkowników."

#: lib/policy.py:1952
msgid "Admin is allowed to set the password of the HSM/Security Module."
msgstr "Administrator może ustawiać hasło HSM/modułu bezpieczeństwa."

#: lib/policy.py:1956
msgid "Admin is allowed to retrieve the list of active challenges."
msgstr "Administrator może pobierać listę aktywnych wyzwań."

#: lib/policy.py:1962
msgid "Admin is allowed to write new SMTP server definitions."
msgstr "Administrator może tworzyć definicje serwerów SMTP."

#: lib/policy.py:1967
msgid "Admin is allowed to read SMTP server definitions."
msgstr "Administrator może odczytywać definicje serwerów SMTP."

#: lib/policy.py:1972
msgid "Admin is allowed to write new RADIUS server definitions."
msgstr "Administrator może tworzyć definicje serwerów RADIUS."

#: lib/policy.py:1978
msgid "Admin is allowed to read RADIUS server definitions."
msgstr "Administrator może odczytywać definicje serwerów RADIUS."

#: lib/policy.py:1983
msgid "Admin is allowed to write remote privacyIDEA server definitions."
msgstr ""
"Administrator może tworzyć i modyfikować definicje zdalnych serwerów "
"privacyIDEA."

#: lib/policy.py:1990
msgid "Admin is allowed to read remote privacyIDEA server definitions."
msgstr "Administrator może odczytywać definicje zdalnych serwerów privacyIDEA."

#: lib/policy.py:1997
msgid "Admin is allowed to write periodic task definitions."
msgstr "Administrator może tworzyć i modyfikować definicje zadań cyklicznych."

#: lib/policy.py:2002
msgid "Admin is allowed to read periodic task definitions."
msgstr "Administrator może odczytywać definicje zadań cyklicznych."

#: lib/policy.py:2007
msgid "Admin is allowed to read statistics data."
msgstr "Administrator może odczytywać dane statystyczne."

#: lib/policy.py:2010
msgid "Admin is allowed to delete statistics data."
msgstr "Administrator może usuwać dane statystyczne."

#: lib/policy.py:2013
msgid "Admin is allowed to write and modify the event handling configuration."
msgstr "Administrator może tworzyć i modyfikować konfigurację obsługi zdarzeń."

#: lib/policy.py:2019
msgid "Admin is allowed to read event handling configuration."
msgstr "Administrator może odczytywać konfigurację obsługi zdarzeń."

#: lib/policy.py:2024
msgid "Admin is allowed to write and modify SMS gateway definitions."
msgstr "Administrator może tworzyć i modyfikować definicje bram SMS."

#: lib/policy.py:2030
msgid "Admin is allowed to read SMS gateway definitions."
msgstr "Administrator może odczytywać definicje bram SMS."

#: lib/policy.py:2035
msgid ""
"Admin is allowed to get the list of authenticated clients and their types."
msgstr ""
"Administrator może pobierać listę uwierzytelnionych klientów i ich typów."

#: lib/policy.py:2042
msgid "Admin is allowed to add and delete component subscriptions."
msgstr "Administrator może dodawać i usuwać subskrypcje komponentów."

#: lib/policy.py:2048
msgid "The Admin is allowed to trigger a challenge for e.g. SMS OTP token."
msgstr "Administrator może wywołać wyzwanie, np. dla tokena SMS OTP."

#: lib/policy.py:2054
msgid ""
"The Admin is allowed to set certain custom user attributes. If the Admin "
"should be allowed to set any attribute, set this to '*:*'. For more details, "
"check the documentation."
msgstr ""
"Administrator może ustawiać wybrane niestandardowe atrybuty użytkownika. Aby "
"zezwolić na ustawianie dowolnego atrybutu, wpisz '*:*'. Więcej informacji "
"zawiera dokumentacja."

#: lib/policy.py:2062
msgid ""
"The Admin is allowed to delete certain custom user attributes. If the Admin "
"should be allowed to delete any attribute, set this to '*'. For more "
"details, check the documentation."
msgstr ""
"Administrator może usuwać wybrane niestandardowe atrybuty użytkownika. Aby "
"zezwolić na usuwanie dowolnego atrybutu, wpisz '*'. Więcej informacji "
"zawiera dokumentacja."

#: lib/policy.py:2070
msgid ""
"A whitespace-separated list of tokeninfo fields which are not displayed to "
"the admin."
msgstr ""
"Lista pól tokeninfo niewidocznych dla administratora, oddzielonych spacjami."

#: lib/policy.py:2075
msgid "The Admin is allowed list the available tokengroups."
msgstr "Administrator może wyświetlać dostępne grupy tokenów."

#: lib/policy.py:2080
msgid "The Admin is allowed to add a new tokengroup."
msgstr "Administrator może dodawać grupy tokenów."

#: lib/policy.py:2085
msgid "The Admin is allowed delete a tokengroup."
msgstr "Administrator może usuwać grupy tokenów."

#: lib/policy.py:2090
msgid "The Admin is allowed list the available service ID definitions."
msgstr "Administrator może wyświetlać dostępne definicje identyfikatorów usług."

#: lib/policy.py:2095
msgid "The Admin is allowed to add a new service ID definition."
msgstr "Administrator może dodawać definicje identyfikatorów usług."

#: lib/policy.py:2100
msgid "The Admin is allowed delete a service ID definition."
msgstr "Administrator może usuwać definicje identyfikatorów usług."

#: lib/policy.py:2105
msgid "The Admin is allowed to manage the tokengroups of a token."
msgstr "Administrator może zarządzać przypisaniem tokena do grup tokenów."

#: lib/policy.py:2109
msgid "Admin is allowed to edit the container info."
msgstr "Administrator może edytować informacje o kontenerze."

#: lib/policy.py:2113
msgid "Admin is allowed to edit the container state."
msgstr "Administrator może edytować stan kontenera."

#: lib/policy.py:2117
msgid "Admin is allowed to edit the container description."
msgstr "Administrator może edytować opis kontenera."

#: lib/policy.py:2121
msgid "Admin is allowed to create containers."
msgstr "Administrator może tworzyć kontenery."

#: lib/policy.py:2125
msgid "Admin is allowed to delete containers."
msgstr "Administrator może usuwać kontenery."

#: lib/policy.py:2129
msgid "Admin is allowed to add tokens to containers."
msgstr "Administrator może dodawać tokeny do kontenerów."

#: lib/policy.py:2133
msgid "Admin is allowed to remove tokens from containers."
msgstr "Administrator może odłączać tokeny od kontenerów."

#: lib/policy.py:2137
msgid "Admin is allowed to assign users to containers."
msgstr "Administrator może przypisywać użytkowników do kontenerów."

#: lib/policy.py:2141
msgid "Admin is allowed to unassign users from containers."
msgstr "Administrator może usuwać przypisania użytkowników do kontenerów."

#: lib/policy.py:2145
msgid "Admin is allowed to set the realm of containers."
msgstr "Administrator może ustawiać domenę kontenerów."

#: lib/policy.py:2149
msgid "Admin is allowed to list containers."
msgstr "Administrator może wyświetlać listę kontenerów."

#: lib/policy.py:2153
msgid "Admin is allowed to register containers."
msgstr "Administrator może rejestrować kontenery."

#: lib/policy.py:2157
msgid "Admin is allowed to unregister containers."
msgstr "Administrator może wyrejestrowywać kontenery."

#: lib/policy.py:2161
msgid ""
"Admin is allowed to perform a container rollover including a rollover of all "
"contained tokens."
msgstr ""
"Administrator może ponownie rejestrować kontener i odnawiać wszystkie "
"zawarte w nim tokeny."

#: lib/policy.py:2167
msgid "Admin is allowed to create and edit container templates."
msgstr "Administrator może tworzyć i edytować szablony kontenerów."

#: lib/policy.py:2171
msgid "Admin is allowed to delete templates."
msgstr "Administrator może usuwać szablony."

#: lib/policy.py:2176
msgid "Admin is allowed to list templates and view their details."
msgstr "Administrator może wyświetlać listę szablonów i ich szczegóły."

#: lib/policy.py:2181
msgid ""
"A whitespace-separated list of container info keys that shall not be "
"displayed to the admin."
msgstr ""
"Lista kluczy informacji o kontenerze niewidocznych dla administratora, "
"oddzielonych spacjami."

#: lib/policy.py:2188
msgid ""
"The user is allowed to assign an existing token that is not yet assigned "
"using the token serial number."
msgstr ""
"Użytkownik może przypisać sobie nieprzypisany token na podstawie jego numeru "
"seryjnego."

#: lib/policy.py:2194
msgid "The user is allowed to disable his own tokens."
msgstr "Użytkownik może wyłączać własne tokeny."

#: lib/policy.py:2198
msgid "The user is allowed to enable his own tokens."
msgstr "Użytkownik może włączać własne tokeny."

#: lib/policy.py:2202
msgid "The user is allowed to delete his own tokens."
msgstr "Użytkownik może usuwać własne tokeny."

#: lib/policy.py:2206
msgid "The user is allowed to unassign his own tokens."
msgstr "Użytkownik może usuwać przypisania własnych tokenów."

#: lib/policy.py:2210
msgid "The user is allowed to resynchronize his tokens."
msgstr "Użytkownik może ponownie synchronizować własne tokeny."

#: lib/policy.py:2214
msgid "The user is allowed to revoke a token"
msgstr "Użytkownik może unieważniać tokeny"

#: lib/policy.py:2218
msgid "The user is allowed to reset the failcounter of his tokens."
msgstr "Użytkownik może zerować liczniki błędów własnych tokenów."

#: lib/policy.py:2222
msgid "The user is allowed to set the OTP PIN of his tokens."
msgstr "Użytkownik może ustawiać PIN własnych tokenów."

#: lib/policy.py:2226
msgid "The user is allowed to set a random OTP PIN of his tokens."
msgstr "Użytkownik może ustawiać losowy PIN własnych tokenów."

#: lib/policy.py:2231
msgid "The length of a random PIN set by the user."
msgstr "Długość losowego PIN-u ustawianego przez użytkownika."

#: lib/policy.py:2234
msgid "The user is allowed to set the token description."
msgstr "Użytkownik może ustawiać opis tokena."

#: lib/policy.py:2238
msgid "The user is allowed to set the OTP PIN during enrollment."
msgstr "Użytkownik może ustawiać PIN tokena podczas rejestracji."

#: lib/policy.py:2256
msgid "Allow the user to view his own token history."
msgstr "Użytkownik może wyświetlać historię własnych tokenów."

#: lib/policy.py:2259
msgid "The user will only see audit entries of the last 10d, 3m or 2y."
msgstr ""
"Użytkownik zobaczy tylko własne wpisy audytu z ostatnich 10d, 3m lub 2y."

#: lib/policy.py:2262
msgid "The user will not see the specified columns in the audit."
msgstr "Użytkownik nie zobaczy wskazanych kolumn audytu."

#: lib/policy.py:2266
msgid "The user is allowed to view his own user information."
msgstr "Użytkownik może wyświetlać własne dane użytkownika."

#: lib/policy.py:2269
msgid ""
"The user is allowed to update his own user information, like changing his "
"password."
msgstr "Użytkownik może aktualizować własne dane, np. zmieniać hasło."

#: lib/policy.py:2274
msgid ""
"The user is allowed to do a password reset in an editable UserIdResolver."
msgstr ""
"Użytkownik może zresetować hasło w edytowalnym źródle użytkowników "
"(UserIdResolver)."

#: lib/policy.py:2279
msgid ""
"The user is allowed to set certain custom user attributes. If the user "
"should be allowed to set any attribute, set this to '*:*'. Use '*' with "
"CAUTION! For more details, check the documentation."
msgstr ""
"Użytkownik może ustawiać określone niestandardowe atrybuty użytkownika. Aby "
"zezwolić na ustawianie dowolnego atrybutu, ustaw '*:*'. Używaj '*' "
"ostrożnie! Więcej informacji znajduje się w dokumentacji."

#: lib/policy.py:2286
msgid ""
"The user is allowed to delete certain custom user attributes. If the user "
"should be allowed to delete any attribute, set this to '*'. Use '*' with "
"CAUTION! For more details, check the documentation."
msgstr ""
"Użytkownik może usuwać określone niestandardowe atrybuty użytkownika. Aby "
"zezwolić na usuwanie dowolnego atrybutu, ustaw '*'. Używaj '*' ostrożnie! "
"Więcej informacji znajduje się w dokumentacji."

#: lib/policy.py:2294
msgid ""
"A whitespace-separated list of tokeninfo fields which are not displayed to "
"the user."
msgstr ""
"Rozdzielona spacjami lista pól tokeninfo, które nie są wyświetlane "
"użytkownikowi."

#: lib/policy.py:2300
msgid "Users are allowed to edit the state of their own containers."
msgstr "Użytkownicy mogą edytować stan swoich kontenerów."

#: lib/policy.py:2305
msgid "Users are allowed to edit the description of their own containers."
msgstr "Użytkownicy mogą edytować opis swoich kontenerów."

#: lib/policy.py:2309
msgid "Users are allowed to create containers."
msgstr "Użytkownicy mogą tworzyć kontenery."

#: lib/policy.py:2313
msgid "Users are allowed to delete their own containers."
msgstr "Użytkownicy mogą usuwać swoje kontenery."

#: lib/policy.py:2318
msgid "Users are allowed to add their own tokens to their own containers."
msgstr "Użytkownicy mogą dodawać swoje tokeny do swoich kontenerów."

#: lib/policy.py:2323
msgid "Users are allowed to remove their own tokens from their own containers."
msgstr "Użytkownicy mogą odłączać własne tokeny od własnych kontenerów."

#: lib/policy.py:2329
msgid "Users are allowed to assign themselves to containers without an owner."
msgstr "Użytkownicy mogą przypisywać się do kontenerów bez właściciela."

#: lib/policy.py:2335
msgid "Users are allowed to unassign themselves from containers."
msgstr "Użytkownicy mogą usuwać swoje przypisania do kontenerów."

#: lib/policy.py:2339
msgid "Users are allowed to list their own containers."
msgstr "Użytkownicy mogą wyświetlać listę swoich kontenerów."

#: lib/policy.py:2344
msgid "Users are allowed to register their own containers."
msgstr "Użytkownicy mogą rejestrować swoje kontenery."

#: lib/policy.py:2348
msgid "Users are allowed to unregister containers."
msgstr "Użytkownicy mogą wyrejestrowywać kontenery."

#: lib/policy.py:2353
msgid ""
"Users are allowed to perform a container rollover of their own containers. "
"This includes a rollover of all contained tokens even if the user is not the "
"owner of a contained token."
msgstr ""
"Użytkownicy mogą ponownie rejestrować swoje kontenery. Obejmuje to "
"odnowienie wszystkich tokenów w kontenerze, nawet jeśli użytkownik nie jest "
"właścicielem któregoś z nich."

#: lib/policy.py:2360
msgid "Users are allowed to create and edit container templates."
msgstr "Użytkownicy mogą tworzyć i edytować szablony kontenerów."

#: lib/policy.py:2364
msgid "Users are allowed to delete templates."
msgstr "Użytkownicy mogą usuwać szablony."

#: lib/policy.py:2369
msgid "Users are allowed to list templates and view their details."
msgstr "Użytkownicy mogą wyświetlać listę szablonów i ich szczegóły."

#: lib/policy.py:2374
msgid ""
"A whitespace-separated list of container info keys that shall not be "
"displayed to the users."
msgstr ""
"Rozdzielona spacjami lista kluczy informacji o kontenerze, które nie są "
"wyświetlane użytkownikom."

#: lib/policy.py:2381
msgid "Limit the number of allowed tokens in a realm."
msgstr "Ogranicz liczbę dozwolonych tokenów w domenie."

#: lib/policy.py:2385
msgid ""
"During the rollout process, this policy makes the description required for "
"all selected tokentypes."
msgstr ""
"Podczas rejestracji ta polityka wymaga opisu dla wszystkich wybranych typów "
"tokenów."

#: lib/policy.py:2393
msgid "Limit the number of tokens a user may have assigned."
msgstr "Ogranicz liczbę tokenów przypisanych użytkownikowi."

#: lib/policy.py:2398
msgid "Limit the number of active tokens a user may have assigned."
msgstr "Ogranicz liczbę aktywnych tokenów przypisanych użytkownikowi."

#: lib/policy.py:2403
msgid ""
"Set a random OTP PIN with this length for a token during the enrollment "
"process."
msgstr "Podczas rejestracji ustaw dla tokena losowy PIN o tej długości."

#: lib/policy.py:2408
msgid "In case of a random OTP PIN use this python module to process the PIN."
msgstr ""
"Dla losowego PIN-u tokena użyj tego modułu Pythona do przetworzenia PIN-u."

#: lib/policy.py:2413
msgid ""
"If the administrator sets the OTP PIN during enrollment or later, the user "
"will have to change the PIN during first use."
msgstr ""
"Jeśli administrator ustawi PIN tokena podczas rejestracji lub później, "
"użytkownik będzie musiał zmienić go przy pierwszym użyciu."

#: lib/policy.py:2420
msgid ""
"The user needs to change his PIN on a regular basis. To change the PIN every "
"180 days, enter '180d'."
msgstr ""
"Użytkownik musi regularnie zmieniać PIN. Aby wymagać zmiany co 180 dni, "
"wpisz '180d'."

#: lib/policy.py:2427
msgid ""
"The OTP PIN can be hashed or encrypted. Hashing the PIN is the default "
"behaviour."
msgstr "PIN tokena może być haszowany lub szyfrowany. Domyślnie jest haszowany."

#: lib/policy.py:2432
#, python-brace-format
msgid ""
"The label for a new enrolled Smartphone token. Possible tags are <code>{user}"
"</code>, <code>{realm}</code>, <code>{serial}</code>, <code>{givenname}</"
"code> and <code>{surname}</code>."
msgstr ""
"Etykieta nowo zarejestrowanego tokena smartfonowego. Dostępne znaczniki: "
"<code>{user}</code>, <code>{realm}</code>, <code>{serial}</code>, <code>"
"{givenname}</code> oraz <code>{surname}</code>."

#: lib/policy.py:2438
#, python-brace-format
msgid ""
"The issuer label for new enrolled Smartphone token.Possible tags are "
"<code>{user}</code>, <code>{realm}</code>, <code>{serial}</code>, "
"<code>{givenname}</code> and <code>{surname}</code>."
msgstr ""
"Etykieta wystawcy nowo zarejestrowanego tokena smartfonowego. Dostępne "
"znaczniki: <code>{user}</code>, <code>{realm}</code>, <code>{serial}</code>, "
"<code>{givenname}</code> oraz <code>{surname}</code>."

#: lib/policy.py:2445
msgid ""
"This is the URL to the token image for the privacyIDEA Authenticator and "
"some other apps like FreeOTP (supported file formats: PNG, JPG and GIF)."
msgstr ""
"Adres URL obrazu tokena dla privacyIDEA Authenticator i innych aplikacji, "
"takich jak FreeOTP (obsługiwane formaty: PNG, JPG i GIF)."

#: lib/policy.py:2452
msgid ""
"Users can assign a token just by using the unassigned token to authenticate."
msgstr ""
"Użytkownik może przypisać token, uwierzytelniając się nieprzypisanym tokenem."

#: lib/policy.py:2458
msgid "The length of the password in case of temporary token (lost token)."
msgstr "Długość hasła tokena tymczasowego (utraconego tokena)."

#: lib/policy.py:2462
msgid ""
"The contents of the temporary password, described by the characters C, c, n, "
"s, 8."
msgstr "Wymagane znaki w haśle tymczasowym, oznaczone jako C, c, n, s, 8."

#: lib/policy.py:2467
msgid "The length of the validity for the temporary token (in days)."
msgstr "Okres ważności tokena tymczasowego w dniach."

#: lib/policy.py:2472
msgid "Set the length of registration codes."
msgstr "Ustaw długość kodów rejestracyjnych."

#: lib/policy.py:2476
msgid ""
"Specify the required contents of the registration code. (c)haracters, "
"(n)umeric, (s)pecial. Use modifiers +/- or a list of allowed characters "
"[1234567890]"
msgstr ""
"Określ wymagane znaki kodu rejestracyjnego: litery (c), cyfry (n) i znaki "
"specjalne (s). Użyj modyfikatorów +/- lub listy dozwolonych znaków "
"[1234567890]"

#: lib/policy.py:2485
msgid "Set the length of the password of generated password tokens."
msgstr "Ustaw długość hasła generowanych tokenów hasłowych."

#: lib/policy.py:2489
msgid ""
"Specify the required contents of the password of a password token. "
"(c)haracters, (n)umeric, (s)pecial. Use modifiers +/- or a list of allowed "
"characters [1234567890]"
msgstr ""
"Określ wymagane znaki hasła tokena hasłowego: litery (c), cyfry (n) i znaki "
"specjalne (s). Użyj modyfikatorów +/- lub listy dozwolonych znaków "
"[1234567890]"

#: lib/policy.py:2497
msgid ""
"Specify the email validator that should be used to validate email addresses "
"during enrollment."
msgstr ""
"Wskaż walidator e-mail używany do sprawdzania adresów e-mail podczas "
"rejestracji."

#: lib/policy.py:2503
msgid ""
"Specify the list of token types, that must be verified during enrollment."
msgstr "Określ typy tokenów, które trzeba zweryfikować podczas rejestracji."

#: lib/policy.py:2516
msgid ""
"Either use the Token PIN , use the Userstore Password or use no fixed "
"password component."
msgstr ""
"Użyj PIN-u tokena, hasła ze źródła użytkowników albo nie używaj stałego "
"składnika hasła."

#: lib/policy.py:2521
msgid ""
"Specify the list of token types, that must be used with challenge response."
msgstr "Określ typy tokenów, które muszą używać odpowiedzi na wyzwanie."

#: lib/policy.py:2529
msgid ""
"Use an alternative challenge text for telling the user to enter an OTP "
"value. You can also use tags for automated replacement. Check out the "
"documentation for more details."
msgstr ""
"Użyj innego tekstu wyzwania z prośbą o wprowadzenie kodu OTP. Możesz używać "
"znaczników zastępowanych automatycznie. Więcej informacji znajduje się w "
"dokumentacji."

#: lib/policy.py:2536
msgid ""
"If there are several different challenges, this text precedes the list of "
"the challenge texts."
msgstr "Jeśli występuje kilka różnych wyzwań, ten tekst poprzedza ich listę."

#: lib/policy.py:2541
msgid ""
"If there are several different challenges, this text follows the list of the "
"challenge texts."
msgstr ""
"Jeśli występuje kilka różnych wyzwań, ten tekst jest wyświetlany po ich "
"liście."

#: lib/policy.py:2546
msgid ""
"If the PIN of a token is to be changed, this will allow the user to change "
"the PIN during a validate/check request via challenge / response."
msgstr ""
"Pozwala użytkownikowi zmienić PIN tokena w żądaniu validate/check za pomocą "
"mechanizmu wyzwania i odpowiedzi."

#: lib/policy.py:2551
msgid ""
"Specify the list of token types, that can not be used for authentication."
msgstr "Określ typy tokenów, których nie można używać do uwierzytelniania."

#: lib/policy.py:2558
msgid ""
"The autoresync of a token can be done via a challenge response message.You "
"need to activate 'Automatic resync' in the general settings!"
msgstr ""
"Ponowną synchronizację tokena można wykonać przez odpowiedź na wyzwanie. W "
"ustawieniach ogólnych włącz opcję „Automatyczna ponowna synchronizacja "
"podczas uwierzytelniania”."

#: lib/policy.py:2563
msgid ""
"In case of a successful authentication the following token or container type "
"is enrolled. The maximum number of tokens for a user is checked."
msgstr ""
"Po udanym uwierzytelnieniu zostanie zarejestrowany wskazany typ tokena lub "
"kontenera. System sprawdzi maksymalną liczbę tokenów użytkownika."

#: lib/policy.py:2569
msgid "Change the default text that is shown during enrolling a token."
msgstr "Zmień domyślny tekst wyświetlany podczas rejestracji tokena."

#: lib/policy.py:2574
msgid ""
"Select the template to use for the enrollment of a smartphone container via "
"multichallenge."
msgstr ""
"Wybierz szablon używany do rejestracji kontenera smartfonowego za pomocą "
"mechanizmu multichallenge."

#: lib/policy.py:2580
msgid ""
"If enabled, the user can choose to skip enrollment of the token during "
"authentication. If disabled, the user must enroll a token. This is also the "
"default behavior."
msgstr ""
"Po włączeniu użytkownik może pominąć rejestrację tokena podczas "
"uwierzytelniania. Po wyłączeniu musi zarejestrować token. Jest to ustawienie "
"domyślne."

#: lib/policy.py:2585
msgid ""
"If enabled, a successful registration with the enroll_via_multichallenge "
"action for passkeys will directly mark the token for offline use and send "
"the offline data."
msgstr ""
"Po włączeniu udana rejestracja klucza dostępu za pomocą akcji "
"enroll_via_multichallenge od razu oznaczy token do użytku offline i wyśle "
"dane offline."

#: lib/policy.py:2591
msgid ""
"If set, the user in this realm will be authenticated against the userstore "
"or against the given RADIUS config, if the user has no tokens assigned."
msgstr ""
"Po włączeniu użytkownik z tej domeny, który nie ma przypisanych tokenów, "
"zostanie uwierzytelniony w źródle użytkowników lub przy użyciu podanej "
"konfiguracji RADIUS."

#: lib/policy.py:2598
msgid ""
"This allows to automatically assign a Token within privacyIDEA, if the user "
"was authenticated via passthru against a RADIUS server. The OTP value is "
"used to find the unassigned token in privacyIDEA. Enter the length of the "
"OTP value and where the PIN is set like 8:pin or pin:6."
msgstr ""
"Automatycznie przypisuje token w privacyIDEA, gdy użytkownik został "
"uwierzytelniony przez passthru na serwerze RADIUS. Kod OTP służy do "
"znalezienia nieprzypisanego tokena w privacyIDEA. Wprowadź długość kodu OTP "
"i położenie PIN-u, np. 8:pin lub pin:6."

#: lib/policy.py:2605
msgid ""
"If the user has no token, the authentication request for this user will "
"always be true."
msgstr ""
"Jeśli użytkownik nie ma tokena, żądanie uwierzytelnienia tego użytkownika "
"zawsze zwróci true."

#: lib/policy.py:2610
msgid ""
"If the user user does not exist, the authentication request for this non-"
"existing user will always be true."
msgstr ""
"Jeśli użytkownik nie istnieje, żądanie uwierzytelnienia tego użytkownika "
"zawsze zwróci true."

#: lib/policy.py:2616
msgid ""
"Can be used to modify the parameters pass, user and realm in an "
"authentication request. See the documentation for an example."
msgstr ""
"Pozwala zmieniać parametry pass, user i realm w żądaniu uwierzytelnienia. "
"Przykład znajduje się w dokumentacji."

#: lib/policy.py:2623
msgid ""
"In authentication requests, sets or overwrites the realm parameter. It takes "
"precedence over the mangle and setrealm policies."
msgstr ""
"Ustawia lub nadpisuje parametr realm w żądaniach uwierzytelnienia. Ma "
"pierwszeństwo przed politykami mangle i setrealm."

#: lib/policy.py:2628
msgid ""
"If a user authenticates successfully reset the failcounter of all of his "
"tokens."
msgstr ""
"Po udanym uwierzytelnieniu wyzeruj liczniki błędów wszystkich tokenów "
"użytkownika."

#: lib/policy.py:2633
msgid ""
"Increase the failcounter for all the tokens, for which a challenge has been "
"triggered."
msgstr ""
"Zwiększ licznik błędów wszystkich tokenów, dla których wywołano wyzwanie."

#: lib/policy.py:2637
msgid ""
"Cache the password used for authentication and allow authentication with the "
"same credentials for a certain amount of time. Specify timeout like 4h or 4h/"
"5m."
msgstr ""
"Zapisz hasło użyte do uwierzytelnienia w pamięci podręcznej i przez "
"określony czas zezwalaj na uwierzytelnianie tymi samymi danymi logowania. "
"Podaj limit czasu, np. 4h lub 4h/5m."

#: lib/policy.py:2644
msgid ""
"You can set the client modes in the order that you prefer. For example: "
"\"interactive webauthn poll u2f\". Accepted values are: <code>interactive "
"webauthn poll u2f</code>"
msgstr ""
"Możesz ustawić tryby klienta w wybranej kolejności, np. \"interactive "
"webauthn poll u2f\". Dozwolone wartości: <code>interactive webauthn poll "
"u2f</code>"

#: lib/policy.py:2650
msgid ""
"When enabled, authentication attempts will be interpreted as either the PIN "
"or the answer to a challenge. PIN concatenated with OTP can not be used "
"anymore! Does only work when authenticating with a username."
msgstr ""
"Po włączeniu próby uwierzytelnienia są interpretowane jako PIN albo "
"odpowiedź na wyzwanie. Nie można już używać PIN-u połączonego z kodem OTP! "
"Działa tylko przy uwierzytelnianiu nazwą użytkownika."

#: lib/policy.py:2656
msgid ""
"Store the last used token type per user and application in the custom user "
"attributes. For the next authentication the last used token type is used to "
"identify the preferred client mode."
msgstr ""
"Zapisz ostatnio użyty typ tokena dla każdego użytkownika i aplikacji w "
"niestandardowych atrybutach użytkownika. Przy kolejnym uwierzytelnieniu "
"posłuży on do określenia preferowanego trybu klienta."

#: lib/policy.py:2662
msgid ""
"Enable to return an unspecific error message for failed authentications."
msgstr "Zwracaj ogólny komunikat błędu po nieudanym uwierzytelnieniu."

#: lib/policy.py:2668
#, python-brace-format
msgid ""
"Allow the user to authenticate (default). If set to '{0!s}', the "
"authentication of the user will be denied."
msgstr ""
"Zezwól użytkownikowi na uwierzytelnianie (domyślnie). Ustawienie '{0!s}' "
"zablokuje uwierzytelnianie użytkownika."

#: lib/policy.py:2675
msgid ""
"Allow the application to choose which token types should be used for "
"authentication. Application may set the parameter 'type' in the request. "
"Works with validate/check, validate/samlcheck and validate/triggerchallenge."
msgstr ""
"Zezwól aplikacji wybrać typy tokenów używane do uwierzytelniania. Aplikacja "
"może ustawić parametr 'type' w żądaniu. Działa z validate/check, validate/"
"samlcheck i validate/triggerchallenge."

#: lib/policy.py:2682
msgid ""
"You can specify how many successful authentication requests a user is "
"allowed to do in a given time. Specify like 1/5s, 2/10m, 10/1h - s, m, h "
"being second, minute and hour."
msgstr ""
"Określ dopuszczalną liczbę udanych żądań uwierzytelnienia użytkownika w "
"danym czasie, np. 1/5s, 2/10m lub 10/1h, gdzie s, m i h oznaczają sekundę, "
"minutę i godzinę."

#: lib/policy.py:2690
msgid ""
"You can specify how many failed authentication requests a user is allowed to "
"do in a given time. Specify like 1/5s, 2/10m, 10/1h - s, m, h being second, "
"minute and hour."
msgstr ""
"Określ dopuszczalną liczbę nieudanych żądań uwierzytelnienia użytkownika w "
"danym czasie, np. 1/5s, 2/10m lub 10/1h, gdzie s, m i h oznaczają sekundę, "
"minutę i godzinę."

#: lib/policy.py:2698
msgid ""
"You can specify in which time frame the user needs to authenticate again "
"with this token. If the user authenticates later, authentication will fail. "
"Specify like 30h, 7d or 1y."
msgstr ""
"Określ czas, w którym użytkownik musi ponownie uwierzytelnić się tym "
"tokenem. Późniejsza próba zakończy się niepowodzeniem. Podaj np. 30h, 7d lub "
"1y."

#: lib/policy.py:2706
msgid "The user will only be authenticated with this very tokentype."
msgstr "Użytkownik zostanie uwierzytelniony wyłącznie tym typem tokena."

#: lib/policy.py:2713
msgid ""
"The user will only be authenticated if the serial number of the token "
"matches this regexp."
msgstr ""
"Użytkownik zostanie uwierzytelniony tylko wtedy, gdy numer seryjny tokena "
"pasuje do tego wyrażenia regularnego."

#: lib/policy.py:2719
msgid ""
"The user will only be authenticated if the tokeninfo field matches the "
"regexp (key/&lt;regexp&gt;/)."
msgstr ""
"Użytkownik zostanie uwierzytelniony tylko wtedy, gdy pole tokeninfo pasuje "
"do wyrażenia regularnego (key/&lt;regexp&gt;/)."

#: lib/policy.py:2726
msgid ""
"The Realm of the user is set to this very realm. This is important if the "
"user is not contained in the default realm and can not pass his realm."
msgstr ""
"Domena użytkownika zostanie ustawiona na tę domenę. Jest to ważne, jeśli "
"użytkownik nie należy do domeny domyślnej i nie może przekazać swojej domeny."

#: lib/policy.py:2733
msgid ""
"In case of successful authentication additional no detail information will "
"be returned."
msgstr "Po udanym uwierzytelnieniu nie zostaną zwrócone dodatkowe szczegóły."

#: lib/policy.py:2740
msgid ""
"In case of failed authentication additional no detail information will be "
"returned."
msgstr "Po nieudanym uwierzytelnieniu nie zostaną zwrócone dodatkowe szczegóły."

#: lib/policy.py:2747
msgid ""
"In case of successful authentication user data will be added in the detail "
"branch of the authentication response."
msgstr ""
"Po udanym uwierzytelnieniu dane użytkownika zostaną dodane do sekcji detail "
"odpowiedzi uwierzytelnienia."

#: lib/policy.py:2754
msgid ""
"In case of successful authentication the user resolver and realm will be "
"added in the detail branch of the authentication response."
msgstr ""
"Po udanym uwierzytelnieniu źródło użytkowników i domena zostaną dodane do "
"sekcji detail odpowiedzi uwierzytelnienia."

#: lib/policy.py:2761
msgid ""
"The sending of an API Auth Key is required during authentication. This "
"avoids rogue authenticate requests against the /validate/check interface."
msgstr ""
"Podczas uwierzytelniania wymagane jest przesłanie klucza uwierzytelniającego "
"API. Zapobiega to nieuprawnionym żądaniom uwierzytelnienia wysyłanym do "
"interfejsu /validate/check."

#: lib/policy.py:2768
msgid ""
"If set, the /healthz/resolversz endpoint requires a valid admin "
"authentication token to include the status of each resolver individually."
msgstr ""
"Po włączeniu endpoint /healthz/resolversz wymaga ważnego tokena "
"uwierzytelniającego administratora, aby zwrócić osobny status każdego źródła "
"użytkowników."

#: lib/policy.py:2776
msgid ""
"If set, administrators will see a dashboard as start screen when logging in "
"to privacyIDEA WebUI."
msgstr ""
"Po włączeniu administratorzy po zalogowaniu do WebUI privacyIDEA zobaczą "
"pulpit jako ekran startowy."

#: lib/policy.py:2782
msgid ""
"If set to \"privacyIDEA\" the users and admins need to authenticate against "
"privacyIDEA when they log in to the Web UI. Defaults to \"userstore\"."
msgstr ""
"Po ustawieniu \"privacyIDEA\" użytkownicy i administratorzy muszą "
"uwierzytelniać się w privacyIDEA podczas logowania do WebUI. Domyślna "
"wartość to \"userstore\"."

#: lib/policy.py:2790
msgid ""
"An alternative text to display on the WebUI login dialog instead of \"Please "
"sign in\"."
msgstr "Inny tekst wyświetlany w oknie logowania WebUI zamiast \"Zaloguj się\"."

#: lib/policy.py:2794
msgid ""
"When searching in the user list, the search will only performed when "
"pressing enter."
msgstr ""
"Wyszukiwanie na liście użytkowników rozpoczyna się dopiero po naciśnięciu "
"klawisza Enter."

#: lib/policy.py:2799
msgid ""
"The action taken when a user is idle beyond the logout_time limit. Defaults "
"to \"lockscreen\"."
msgstr ""
"Akcja wykonywana, gdy bezczynność użytkownika przekroczy limit logout_time. "
"Domyślnie: \"lockscreen\"."

#: lib/policy.py:2807
msgid ""
"The REMOTE_USER set by the webserver can be used to login to privacyIDEA or "
"it will be ignored. Defaults to \"disable\"."
msgstr ""
"Wartość REMOTE_USER ustawiona przez serwer WWW może służyć do logowania do "
"privacyIDEA albo zostać zignorowana. Domyślnie: \"disable\"."

#: lib/policy.py:2813
msgid ""
"Set the time in seconds after which the user will be logged out from the "
"WebUI. Default: 120"
msgstr ""
"Ustaw czas w sekundach, po którym użytkownik zostanie wylogowany z WebUI. "
"Domyślnie: 120"

#: lib/policy.py:2818
msgid ""
"privacyIDEA issues a JWT when the user or admins logs in to the WebUI. The "
"default validity is 1 hour. You can specify different validity times in "
"seconds."
msgstr ""
"privacyIDEA wystawia token JWT, gdy użytkownik lub administrator loguje się "
"do WebUI. Domyślny okres ważności to 1 godzina. Możesz podać inną wartość w "
"sekundach."

#: lib/policy.py:2823
msgid "Set how many tokens should be displayed in the token view on one page."
msgstr "Ustaw liczbę tokenów wyświetlanych na jednej stronie."

#: lib/policy.py:2828
msgid "Set how many users should be displayed in the user view on one page."
msgstr "Ustaw liczbę użytkowników wyświetlanych na jednej stronie."

#: lib/policy.py:2833
msgid ""
"Set how many audit entries should be displayed in the audit view on one page."
msgstr "Ustaw liczbę wpisów audytu wyświetlanych na jednej stronie."

#: lib/policy.py:2838
msgid "Use your own html template for the web UI menu."
msgstr "Użyj własnego szablonu HTML menu WebUI."

#: lib/policy.py:2842
msgid "Use your own html template for the web UI baseline/footer."
msgstr "Użyj własnego szablonu HTML dolnego paska lub stopki WebUI."

#: lib/policy.py:2846
msgid "Link your privacy statement to be displayed in the baseline/footer."
msgstr ""
"Podaj odnośnik do polityki prywatności wyświetlanej w dolnym pasku lub "
"stopce."

#: lib/policy.py:2850
msgid ""
"Whether the user ID and the resolver should be displayed in the token list."
msgstr ""
"Określ, czy identyfikator użytkownika i źródło użytkowników mają być "
"wyświetlane na liście tokenów."

#: lib/policy.py:2855
msgid ""
"The URL of a repository, where the policy templates can be found.  (Default /"
"static/policy-templates/"
msgstr ""
"Adres URL repozytorium z szablonami polityk (domyślnie: /static/policy-"
"templates/)."

#: lib/policy.py:2861
msgid ""
"The URL of an SSO provider for redirect at logout.(The URL must start with "
"http:// or https://)"
msgstr ""
"Adres URL dostawcy SSO, do którego nastąpi przekierowanie po wylogowaniu. "
"(Adres URL musi zaczynać się od http:// lub https://)"

#: lib/policy.py:2866
msgid ""
"As long as a user has no token, he will only see a token wizard in the UI."
msgstr ""
"Dopóki użytkownik nie ma tokena, w interfejsie widzi tylko kreator "
"rejestracji tokena."

#: lib/policy.py:2872
msgid ""
"The tokenwizard will be displayed in the token menu, even if the user "
"already has a token."
msgstr ""
"Kreator rejestracji tokena będzie widoczny w menu tokenów, nawet jeśli "
"użytkownik ma już token."

#: lib/policy.py:2878
msgid ""
"This is a whitespace separated list of tokentypes, for which a rollover "
"button is displayed in the token details."
msgstr ""
"Rozdzielona spacjami lista typów tokenów, dla których w szczegółach tokena "
"jest wyświetlany przycisk odnowienia."

#: lib/policy.py:2885
msgid ""
"The welcome dialog will be displayed if the user has no tokens assigned."
msgstr ""
"Okno powitalne zostanie wyświetlone, jeśli użytkownik nie ma przypisanych "
"tokenów."

#: lib/policy.py:2889
msgid "This is the default token type in the token enrollment dialog."
msgstr "Domyślny typ tokena w oknie rejestracji tokena."

#: lib/policy.py:2895
msgid "This is the default container type in the container create dialog."
msgstr "Domyślny typ kontenera w oknie tworzenia kontenera."

#: lib/policy.py:2900
msgid ""
"A list of realm names, which are displayed in a drop down menu in the WebUI "
"login screen. Realms are separated by white spaces. The order of the realms "
"in the policy is preserved in the drop down. Include '-' as an entry to add "
"an empty option. The first option specified here will be preselected."
msgstr ""
"Lista domen w menu na ekranie logowania WebUI. Nazwy rozdziel spacjami. "
"Kolejność z polityki zostanie zachowana. Wpis '-' doda pustą opcję. Pierwsza "
"domena będzie wybrana domyślnie."

#: lib/policy.py:2909
msgid ""
"If this is checked, the administrator will not see the welcome dialog "
"anymore."
msgstr "Po zaznaczeniu administrator nie będzie już widział okna powitalnego."

#: lib/policy.py:2914
msgid ""
"Per default disabled actions result in disabled buttons. When checking this "
"action, buttons of disabled actions are hidden."
msgstr ""
"Domyślnie niedostępne akcje mają wyłączone przyciski. Po zaznaczeniu tej "
"opcji przyciski niedostępnych akcji są ukrywane."

#: lib/policy.py:2919
msgid ""
"If this is checked, there will be a confirmation prompt when deleting "
"policies, events, mresolver, resolver or periodic tasks!"
msgstr ""
"Po zaznaczeniu usuwanie polityk, zdarzeń, źródeł maszyn, źródeł użytkowników "
"i zadań cyklicznych wymaga potwierdzenia!"

#: lib/policy.py:2924
msgid ""
"If this is checked, the seed will be displayed as text during enrollment."
msgstr ""
"Po zaznaczeniu sekret tokena będzie wyświetlany jako tekst podczas "
"rejestracji."

#: lib/policy.py:2929
msgid ""
"If this is checked, the privacyIDEA Node name will be displayed in the menu "
"bar."
msgstr ""
"Po zaznaczeniu nazwa węzła privacyIDEA będzie wyświetlana na pasku menu."

#: lib/policy.py:2934
msgid ""
"If this is checked, the enrollment page for HOTP, TOTP and Push tokens will "
"contain a QR code that leads to the privacyIDEA Authenticator in the Google "
"Play Store."
msgstr ""
"Po zaznaczeniu strona rejestracji tokenów HOTP, TOTP i Push będzie zawierać "
"kod QR prowadzący do privacyIDEA Authenticator w sklepie Google Play."

#: lib/policy.py:2941
msgid ""
"If this is checked, the enrollment page for HOTP, TOTP and Push tokens will "
"contain a QR code that leads to the privacyIDEA Authenticator in the iOS App "
"Store."
msgstr ""
"Po zaznaczeniu strona rejestracji tokenów HOTP, TOTP i Push będzie zawierać "
"kod QR prowadzący do privacyIDEA Authenticator w iOS App Store."

#: lib/policy.py:2948
msgid ""
"This action adds a QR code in the enrollment page for HOTP, TOTP and Push "
"tokens, that lead to this given URL."
msgstr ""
"Ta akcja dodaje na stronie rejestracji tokenów HOTP, TOTP i Push kod QR "
"prowadzący do podanego adresu URL."

#: lib/policy.py:2953
msgid ""
"The RSS feeds fetched for the user defined in the format: "
"<code>'Title':'URL'-'Title':'URL'</code> "
msgstr ""
"Kanały RSS pobierane dla użytkownika, zdefiniowane w formacie: <code>"
"'Title':'URL'-'Title':'URL'</code> "

#: lib/policy.py:2957
msgid ""
"The age of the RSS feed entries in days. Use <code>0</code> to hide the news "
"feed. For admins the default is 180 days and for users 0 days."
msgstr ""
"Maksymalny wiek wpisów kanału RSS w dniach. Użyj <code>0</code>, aby ukryć "
"kanał wiadomości. Domyślna wartość to 180 dni dla administratorów i 0 dni "
"dla użytkowników."

#: lib/policy.py:2962
msgid ""
"Container type to be created with the container wizard. It is required to "
"set at least this option to enable the container wizard. As long as the user "
"has no container assigned he will only see the container wizard in the UI."
msgstr ""
"Typ kontenera tworzonego przez kreator kontenera. Aby włączyć kreator, "
"trzeba ustawić co najmniej tę opcję. Dopóki użytkownik nie ma przypisanego "
"kontenera, w interfejsie widzi tylko kreator kontenera."

#: lib/policy.py:2969
msgid ""
"Name of the container template to be used to create a container in the "
"container wizard (optional). Note that the template must be of the same type "
"as selected in the container_wizard_type."
msgstr ""
"Nazwa szablonu kontenera używanego przez kreator kontenera (opcjonalnie). "
"Szablon musi być tego samego typu co wybrany w container_wizard_type."

#: lib/policy.py:2976
msgid ""
"In the container wizard, a QR code will be generated to register the new "
"container on the smartphone. (Only applicable for smartphone containers)"
msgstr ""
"Kreator kontenera wygeneruje kod QR do rejestracji nowego kontenera na "
"smartfonie. (Dotyczy tylko kontenerów smartfonowych)"

#: lib/policy.py:2982
msgid "Show or hide the passkey login button on the login screen."
msgstr ""
"Pokaż lub ukryj przycisk logowania kluczem dostępu na ekranie logowania."

#: lib/policy.py:2988
msgid ""
"The URL of your privacyIDEA server, e.g. <code>https://pi/</code>. It is "
"used to build URLs the container can contact for registration and "
"synchronization."
msgstr ""
"Adres URL serwera privacyIDEA, np. <code>https://pi/</code>. Służy do "
"tworzenia adresów URL, z którymi kontener łączy się podczas rejestracji i "
"synchronizacji."

#: lib/policy.py:2994
msgid ""
"The time in minutes the client has to do the second step of the "
"registration. The default is ten minutes."
msgstr ""
"Czas w minutach na wykonanie przez klienta drugiego kroku rejestracji. "
"Domyślnie 10 minut."

#: lib/policy.py:3000
msgid ""
"After the client (a registered container) has challenged an action such as "
"synchronization or unregistration, this defines the time in minutes the "
"client has to complete the action. The default is two minutes."
msgstr ""
"Czas w minutach na ukończenie akcji przez klienta (zarejestrowany kontener) "
"po jej zainicjowaniu, np. synchronizacji lub wyrejestrowania. Domyślnie 2 "
"minuty."

#: lib/policy.py:3009
msgid ""
"The container needs to verify the SSL certificate of the privacyIDEA server "
"during registration and synchronization. (default True)"
msgstr ""
"Kontener musi weryfikować certyfikat SSL serwera privacyIDEA podczas "
"rejestracji i synchronizacji (domyślnie: True)."

#: lib/policy.py:3016
msgid ""
"The client is allowed to perform a rollover of the container and the "
"included tokens."
msgstr ""
"Klient może ponownie zarejestrować kontener i odnowić znajdujące się w nim "
"tokeny."

#: lib/policy.py:3021
msgid ""
"During the first synchronization, the server automatically adds the clients "
"tokens existing in privacyIDEA to the container. This allows to register "
"devices with existing tokens as container without having to manually add the "
"tokens on the device to the container."
msgstr ""
"Podczas pierwszej synchronizacji serwer automatycznie dodaje do kontenera "
"istniejące w privacyIDEA tokeny klienta. Pozwala to zarejestrować urządzenie "
"z istniejącymi tokenami jako kontener bez ręcznego dodawania tokenów do "
"kontenera na urządzeniu."

#: lib/policy.py:3028
msgid "The user is not allowed to delete tokens locally on the smartphone."
msgstr "Użytkownik nie może usuwać tokenów lokalnie na smartfonie."

#: lib/policy.py:3033
msgid ""
"The client is not allowed to unregister the container. The user can not "
"delete the container locally on the smartphone."
msgstr ""
"Klient nie może wyrejestrować kontenera. Użytkownik nie może usunąć "
"kontenera lokalnie na smartfonie."

#: lib/policy.py:3040
msgid ""
"Enable to return an unspecific error message for failures in the "
"authentication-free container endpoints."
msgstr ""
"Zwracaj ogólny komunikat o błędach endpointów kontenera niewymagających "
"uwierzytelnienia."

#: lib/policy.py:3046
msgid ""
"This action makes the description required for all selected tokentypes, "
"during the editing process."
msgstr ""
"Ta akcja wymaga opisu podczas edycji wszystkich wybranych typów tokenów."

#: lib/policy.py:3055
msgid ""
"Enable to return an unspecific error message for failures in the special "
"token endpoints /ttype/*."
msgstr ""
"Zwracaj ogólny komunikat o błędach specjalnych endpointów tokenów /ttype/*."

#: lib/policy.py:3059
msgid ""
"Enable to return an unspecific error message for failed offline token "
"refills."
msgstr ""
"Zwracaj ogólny komunikat błędu w razie nieudanego uzupełniania tokenów "
"offline."

