# privacyIDEA single-node compose configuration.
# Copy to .env and adjust. These values are interpolated into compose.yaml.
#
# All sensitive credentials (enckey, pepper, passwords) are Docker secrets in
# ./secrets/ — NOT set here. See secrets/README.md. The configuration of the
# services themselves is in privacyidea.env, caddy.env and mariadb.cnf.

# The compose files of this deployment. Unset, compose reads compose.yaml and,
# if it exists, compose.override.yaml with your own changes. Set it to use an
# external database instead of the bundled MariaDB. Once it is set, compose no
# longer looks for compose.override.yaml: append ":compose.override.yaml" if
# you have one.
#COMPOSE_FILE=compose.yaml:compose.external-db.yaml

# The privacyIDEA image. Unset, compose.yaml runs the release it belongs to; to
# upgrade, take the files of the new release (see "Upgrading" in the README).
# Set it only to run another image, such as privacyidea:local built with
# "make build".
#PI_IMAGE=harbor.netknights.it/privacyidea/privacyidea:<version>

# Username of the initial admin account created by pi-init on first startup.
# The password is stored in secrets/bootstrap_admin_password.
BOOTSTRAP_ADMIN=admin

# Number of gunicorn workers in the pi service (default: 4).
#PI_WORKERS=4

# Optional TLS reverse proxy (Caddy), configured in caddy.env. Uncomment to run
# it with the stack; every command (make up, make down, the scripts) then
# includes it.
#COMPOSE_PROFILES=tls

# The network between Caddy and pi. Caddy has the fixed address PI_PROXY_ADDRESS,
# which is the address to name in the system setting "Override Authorization
# Clients"; Docker gives pi addresses from PI_PROXY_IP_RANGE. Change all three
# together, and only if the subnet collides with a network of yours.
#PI_PROXY_SUBNET=192.168.255.240/28
#PI_PROXY_IP_RANGE=192.168.255.248/29
#PI_PROXY_ADDRESS=192.168.255.242
