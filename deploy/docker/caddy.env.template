# Caddy reverse proxy config, for the "tls" compose profile (COMPOSE_PROFILES=tls
# in .env). Copy to caddy.env and adjust ("make init" does the copy). caddy.env
# is yours: an update of these files never overwrites it.

# Public hostname Caddy serves and gets a certificate for (default: localhost).
#PI_SITE_ADDRESS=privacyidea.example.com

# An optional "tls" directive for the site. "tls internal" makes Caddy issue the
# certificate from its own local CA, for a host without public DNS; clients then
# have to trust that CA. "tls admin@example.com" sets the address Let's Encrypt
# sends expiry notices to.
#PI_CADDY_TLS=tls internal
